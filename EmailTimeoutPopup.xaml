<Window x:Class="ClarityAssessment.EmailTimeoutPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClarityAssessment"
        mc:Ignorable="d"
        Title="EmailTimeoutPopup" Height="160" Width="278" Name="TimeoutPopupWindow">
    <Grid Margin="0,0,0,-16">
        <TextBlock TextWrapping="Wrap" Text="Max Retries Exceeded. Your Email was not sent." Margin="41,20,41,72" FontWeight="Bold" FontSize="16" TextAlignment="Center"/>
        <Button Content="OK" HorizontalAlignment="Center" Height="43" Margin="0,77,0,0" VerticalAlignment="Top" Width="90" Click="Button_Click"/>

    </Grid>
</Window>
